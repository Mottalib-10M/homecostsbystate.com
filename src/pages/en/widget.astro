---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const frames = [
  { slug: 'roof-cost', title: 'Roof replacement cost by state and house size', h: 1050, who: 'Real estate agents, home inspectors, local newsrooms and homeowner associations' },
  { slug: 'concrete', title: 'Concrete calculator: cubic yards and bags', h: 1100, who: 'Hardware stores, DIY blogs, garden and landscaping sites' },
];
const code = (f: (typeof frames)[number]) => `<iframe src="${SITE_URL}/embed/${f.slug}/" title="${f.title}" width="100%" height="${f.h}" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the roof cost or concrete calculator on your site, free" description="Embed a roof replacement cost calculator by state, or a concrete calculator with bag counts, on your own site for free with one iframe line. No cookie, no tracking, no lead form." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed a calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Paste one line of code. When the BLS or the Census Bureau publishes new figures, the embedded calculator updates on its own.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit link under the calculator visible, do not alter the frame, and present the result as an estimate, not a quote. The frame sets no cookie and sends nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    {frames.map((f) => <><h2>{f.title}</h2><p>Useful for: {f.who}.</p><pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(f)}</code></pre></>)}
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/roof-cost/" title="Roof replacement cost by state and house size" width="100%" height="1050" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
