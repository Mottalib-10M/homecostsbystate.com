---
/**
 * Roof replacement cost in one state: the state's figures in a strip (roofer wage, index, typical price),
 * the calculator locked on the state, the folded answer, the prose written for this state, then the
 * generated tables (other jobs in the state, trade wages), marked data-chrome because their form repeats
 * on every state page (RECETTE §6.4).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, statePageById, stateId, ROOF_PILLAR } from '../lib/pages';
import { helpers, SOURCES, table } from '../lib/helpers';
import { KIT } from '../lib/kit';
import { stateRef, WAGE_REF } from '../lib/data';
import { usd, num, day } from '../lib/fmt';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME, LAST_UPDATED } from '../data/site-config';
import type { StateDef } from '../lib/page-types';
interface Props { def: StateDef }
const { def } = Astro.props;
const lang = 'en';
const ui = t(lang);
const S = stateRef(def.slug);
const id = stateId(def.slug);
const path = route(id, lang);
const h1 = `Roof replacement cost in ${S.name}`;
const jsonLd = [webApplicationSchema({ name: h1, description: def.description, path, lang }), articleSchema({ title: h1, description: def.description, path, lang }), webPageSchema({ name: h1, description: def.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: 'Roof replacement cost', path: route(ROOF_PILLAR, lang) }, { name: S.name, path }])];
if (def.faqs.length) jsonLd.push(faqSchema(def.faqs, lang));
const card = (rid: string) => pageById(rid)?.card ?? (statePageById(rid) ? `Roofer wages and the price range in ${stateRef(statePageById(rid)!.slug).name}` : '');
const related = def.related.filter((r) => ROUTES.some((x) => x.id === r)).map((r) => ({ href: route(r, lang), name: label(r), description: card(r) }));
const sources = [...(def.extraSources ?? []), ...['census_ahs', 'bls_oews', 'bls_roofers', 'census_ec', 'bls_cpi'].map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }))];
const parts = def.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const roof = KIT.job('roof', def.slug);
const w = KIT.wage(def.slug, 'roofers');
const nat = KIT.natWage('roofers');
const jobsRows = ['waterHeater', 'centralAc', 'heating', 'fence', 'deckPatio', 'driveway'].map((k) => { const r = KIT.job(k, def.slug); return [`<a href="${route(k === 'waterHeater' ? 'water-heater-replacement-cost' : k === 'fence' ? 'fence-cost-calculator' : k === 'deckPatio' ? 'deck-cost-calculator' : k === 'driveway' ? 'concrete-calculator' : 'hvac-replacement-cost', lang)}">${KIT.jobDef(k).label}</a>`, usd(r.low), usd(r.typical), usd(r.high)]; });
const tradeRows = ['roofers', 'plumbers', 'hvac', 'electricians', 'carpenters', 'painters'].map((o) => { const sw = KIT.wage(def.slug, o); const nw = KIT.natWage(o); return [KIT.occ(o).title, sw ? usd(sw.mean, 2) : 'not published', usd(nw.mean, 2), sw?.emp ? num(sw.emp) : '–']; });
const sizes = KIT.jobInput('roof').bySize!.map((b) => { const r = KIT.job('roof', def.slug, b.bin === 'lt1000' ? 800 : Number(b.bin)); return [b.label, usd(r.low), usd(r.typical), usd(r.high)]; });
---
<PageLayout title={def.title} description={def.description} lang={lang} jsonLd={jsonLd} faqs={def.faqs} related={related} sources={sources} breadcrumbs={[{ label: 'Roof replacement cost', href: route(ROOF_PILLAR, lang) }, { label: S.name }]}>
  <article>
    <header class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">Roof replacement · {S.abbr} · {S.divisionName}</p>
      <h1 class="mt-1 font-serif text-3xl font-bold text-navy-900 md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{def.intro}</p>
      <p class="mt-3 text-sm text-navy-600">Wages: BLS, {WAGE_REF.reference} (released <time datetime={WAGE_REF.released}>{day(WAGE_REF.released)}</time>) · figures checked <time datetime={LAST_UPDATED}>{day(LAST_UPDATED)}</time> · {ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a></p>
    </header>
    <dl data-chrome class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-lg border border-navy-200 p-3"><dt class="text-xs text-navy-600">Typical roof job, all house sizes</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{usd(roof.typical)}</dd></div>
      <div class="rounded-lg border border-navy-200 p-3"><dt class="text-xs text-navy-600">Middle half of jobs</dt><dd class="tabular-nums text-base font-semibold text-navy-900">{usd(roof.low)} to {usd(roof.high)}</dd></div>
      <div class="rounded-lg border border-navy-200 p-3"><dt class="text-xs text-navy-600">Roofer mean wage</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{w ? `${usd(w.mean, 2)}/h` : 'n/a'}</dd></div>
      <div class="rounded-lg border border-navy-200 p-3"><dt class="text-xs text-navy-600">Versus U.S. roofers</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{w ? `${w.mean >= nat.mean ? '+' : '−'}${num(Math.abs(w.mean / nat.mean - 1) * 100, 0)}%` : 'n/a'}</dd></div>
    </dl>
    <div data-outil class="mb-8"><Tool kind="roof-cost" state={def.slug} lock={true} idPrefix={`${S.abbr.toLowerCase()}rf`} /></div>
    <Clamp text={def.resume} lang={lang} id={`clamp-roof-${def.slug}`} class="mb-8" />
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={route(ROOF_PILLAR, lang)} /> : null)}
    </div>
    <section data-chrome class="mt-10">
      <h2 class="font-serif text-2xl font-bold text-navy-900">{S.name} roof prices by house size</h2>
      <Fragment set:html={table(['House size', 'Low', 'Typical', 'High'], sizes, `Professional roof jobs on one-family detached homes, American Housing Survey 2023, adjusted to ${S.name} roofer wages.`, ['l', 'r', 'r', 'r'])} />
      <h2 class="mt-10 font-serif text-2xl font-bold text-navy-900">Other jobs in {S.name}</h2>
      <Fragment set:html={table(['Job', 'Low', 'Typical', 'High'], jobsRows, `Same method, with the wage of each trade in ${S.name}.`, ['l', 'r', 'r', 'r'])} />
      <h2 class="mt-10 font-serif text-2xl font-bold text-navy-900">Trade wages in {S.name}</h2>
      <Fragment set:html={table(['Occupation', `${S.abbr} mean hourly wage`, 'U.S. mean', `${S.abbr} jobs`], tradeRows, `BLS Occupational Employment and Wage Statistics, ${WAGE_REF.reference}.`, ['l', 'r', 'r', 'r'])} />
    </section>
  </article>
</PageLayout>
